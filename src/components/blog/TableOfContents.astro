---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
---

{
	headings.length > 1 && (
		<nav class="toc" aria-label="Table of contents">
			<p class="toc-label">Contents</p>
			<ul>
				{headings.map((h) => (
					<li class:list={{ "toc-h3": h.depth === 3 }}>
						<a href={`#${h.slug}`} data-toc-target={h.slug}>
							{h.text}
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}

<style>
	.toc {
		position: fixed;
		top: 18vh;
		left: calc(50% + 412px);
		width: 190px;
		max-height: 75vh;
		overflow-y: auto;
	}
	.toc-label {
		font-family: var(--font-mono);
		font-size: 10.5px;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--faint);
		margin: 0 0 10px;
	}
	.toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 1px solid var(--hairline);
	}
	.toc li a {
		display: block;
		padding: 5px 0 5px 14px;
		margin-left: -1px;
		border-left: 2px solid transparent;
		font-family: var(--font-sans);
		font-size: 12.5px;
		line-height: 1.4;
		color: hsl(var(--theme-text) / 0.55);
	}
	.toc li.toc-h3 a {
		padding-left: 26px;
		font-size: 11.5px;
	}
	.toc li a:hover {
		color: hsl(var(--theme-text));
	}
	.toc li a.active {
		color: hsl(var(--theme-accent));
		border-left-color: hsl(var(--theme-accent));
	}
	@media (prefers-reduced-motion: no-preference) {
		.toc li a {
			transition: color 0.2s ease, border-color 0.2s ease;
		}
	}
	@media (max-width: 1320px) {
		.toc {
			display: none !important;
		}
	}
</style>

<script>
	const links = document.querySelectorAll<HTMLAnchorElement>(".toc a[data-toc-target]");
	if (links.length && "IntersectionObserver" in window) {
		const linksBySlug = new Map(
			Array.from(links).map((a) => [a.dataset.tocTarget as string, a]),
		);
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					const link = linksBySlug.get((entry.target as HTMLElement).id);
					if (!link) return;
					linksBySlug.forEach((a) => a.classList.remove("active"));
					link.classList.add("active");
				});
			},
			{ rootMargin: "-15% 0px -70% 0px" },
		);
		linksBySlug.forEach((_, slug) => {
			const heading = document.getElementById(slug);
			if (heading) io.observe(heading);
		});
	}
</script>
